# Database
DATABASE_URL=postgresql://architect:architect@localhost:5432/architecture_simplified
POSTGRES_USER=architect
POSTGRES_PASSWORD=architect
POSTGRES_DB=architecture_simplified

# API (host port mapped to container 4000)
API_PORT=8084
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Web (host port mapped to nginx :80)
WEB_PORT=8085
# Use /api when served behind the web nginx proxy (Docker)
VITE_API_URL=/api

# Admin seed credentials (used by seed script only)
ADMIN_EMAIL=admin@architecturesimplified.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Admin
